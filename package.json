{
  "name": "eddie-editor",
  "version": "0.9.0",
  "description": "Eddie — a fast, personal, browser-based editor for markup files (Markdown, JSON, bash), with git built in and an agent-friendly API.",
  "license": "MIT",
  "author": "Ed Wentworth",
  "type": "commonjs",
  "bin": {
    "eddie": "bin/eddie.js"
  },
  "scripts": {
    "build": "esbuild web/src/main.js --bundle --format=iife --outfile=web/dist/app.js --minify",
    "dev": "esbuild web/src/main.js --bundle --format=iife --outfile=web/dist/app.js --watch",
    "start": "node server/server.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.10.2",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.28.0",
    "codemirror": "^6.0.1",
    "markdownlint": "^0.41.1",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
